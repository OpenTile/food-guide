# Copy to .env for local development: `cp .env.example .env`. .env is gitignored.
#
# These values match the local database in docker-compose.yml — start it with `bun run db:up`.
# They are local-only development credentials, not secrets. This repository is public, so the
# deployed connection string and bearer token must only ever exist as platform configuration.
DATABASE_URL=postgres://food_guide:food_guide@localhost:55432/food_guide
PORT=3000
